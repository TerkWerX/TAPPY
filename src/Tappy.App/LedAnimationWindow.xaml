<Window x:Class="Tappy.App.LedAnimationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tappy.App"
        Title="LED animations" Width="1040" Height="600"
        MinWidth="860" MinHeight="520" WindowStartupLocation="CenterOwner"
        Icon="/Tappy;component/Assets/Icons/tappy.ico"
        AutomationProperties.Name="LED animation library and editor">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:FrameCellAspectRatioToWidthConverter x:Key="FrameCellAspectRatioToWidthConverter" />
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBrush}" Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Library" FontWeight="Bold" Margin="0,0,0,6" />
            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                <Button Content="New" Click="NewAnimation_OnClick" Margin="0,0,4,4" />
                <Button Content="Duplicate" Click="DuplicateAnimation_OnClick" Margin="0,0,0,4" />
                <Button Content="Rename…" Click="RenameAnimation_OnClick" Margin="0,0,4,0" />
                <Button Content="Delete" Click="DeleteAnimation_OnClick" />
            </UniformGrid>
            <ListBox x:Name="LibraryList" ItemsSource="{Binding Library}"
                     SelectedItem="{Binding SelectedLibraryEntry, Mode=TwoWay}"
                     AutomationProperties.Name="Saved animations">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AssignmentListTextBrush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Animation name" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="Effect" IsChecked="{Binding IsEffectMode}" GroupName="AnimationMode" Margin="0,0,16,0" />
                <RadioButton Content="Frames" IsChecked="{Binding IsFramesMode}" GroupName="AnimationMode"
                             ToolTip="Hand-paint one or more frames and step through them on a timer." />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,10"
                  Visibility="{Binding IsEffectMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Effect" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding EffectKinds}" SelectedItem="{Binding EffectKind, Mode=TwoWay}"
                              AutomationProperties.Name="Effect kind">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource ComboBoxTextBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Colors" VerticalAlignment="Top" Margin="0,4,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding ColorsText, UpdateSourceTrigger=LostFocus}"
                             AcceptsReturn="False" TextWrapping="Wrap" Height="44"
                             ToolTip="Comma-separated named colors (Red, Amber, Green, …) or #RRGGBB hex values."
                             AutomationProperties.Name="Effect colors" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Effect speed" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Grid.Column="1" Minimum="0.02" Maximum="20" Value="{Binding SpeedHz}" />
                    <TextBlock Grid.Column="2" Text="{Binding SpeedHz, StringFormat={}{0:0.00}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,4" Visibility="{Binding ShowsDensity, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sparkle density" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Grid.Column="1" Minimum="0.01" Maximum="1" Value="{Binding Density}" />
                    <TextBlock Grid.Column="2" Text="{Binding Density, StringFormat={}{0:0.00}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <Grid Grid.Row="4" Margin="0,0,0,4" Visibility="{Binding ShowsTrailLength, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Chase trail length" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Grid.Column="1" Minimum="1" Maximum="32" Value="{Binding TrailLength}" />
                    <TextBlock Grid.Column="2" Text="{Binding TrailLength, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <Grid Grid.Row="5" Margin="0,0,0,0" Visibility="{Binding ShowsWaveDensity, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Wave density" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Grid.Column="1" Minimum="0.1" Maximum="8" Value="{Binding WaveDensity}" />
                    <TextBlock Grid.Column="2" Text="{Binding WaveDensity, StringFormat={}{0:0.00}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,10"
                  Visibility="{Binding IsFramesMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Frames" FontWeight="Bold" Margin="0,0,0,6" />
                    <Button DockPanel.Dock="Bottom" Content="Delete frame" Click="DeleteFrame_OnClick" Margin="0,6,0,0" />
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,6,0,0">
                        <Button Content="Add" Click="AddFrame_OnClick" Margin="0,0,4,4" />
                        <Button Content="Duplicate" Click="DuplicateFrame_OnClick" Margin="0,0,0,4" />
                        <Button Content="▲ Up" Click="MoveFrameUp_OnClick" Margin="0,0,4,0" />
                        <Button Content="▼ Down" Click="MoveFrameDown_OnClick" />
                    </UniformGrid>
                    <ListBox ItemsSource="{Binding FrameChoices}" SelectedItem="{Binding SelectedFrameChoice, Mode=TwoWay}"
                             AutomationProperties.Name="Frame timeline">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource AssignmentListTextBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Frame duration" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider Grid.Column="1" Minimum="16" Maximum="3000" Value="{Binding SelectedFrameChoice.DurationMs}" />
                        <TextBlock Grid.Column="2" Text="{Binding SelectedFrameChoice.DurationMs, StringFormat={}{0} ms}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="Paint color" FontWeight="Bold" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Custom…" Click="OpenFramePaintColorPicker_OnClick"
                                VerticalAlignment="Top" Margin="8,0,0,0" />
                        <ListBox ItemsSource="{Binding PaintColorChoices}" SelectedItem="{Binding SelectedPaintColor, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent" AutomationProperties.Name="Paint color palette">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="24" Height="24" Margin="2" CornerRadius="4"
                                            Background="{Binding Background}" ToolTip="{Binding Label}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CanvasCells}" AutomationProperties.Name="Frame canvas">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding CanvasColumns}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding AspectRatio, Converter={StaticResource FrameCellAspectRatioToWidthConverter}}"
                                            Height="24" Margin="1" CornerRadius="3"
                                            Background="{Binding Background}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            MouseLeftButtonDown="FrameCell_OnMouseLeftButtonDown" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Playback speed" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Grid.Column="1" Minimum="0.1" Maximum="8" Value="{Binding SpeedMultiplier}"
                            ToolTip="Scales the whole animation's playback rate without changing the authored effect parameters." />
                    <TextBlock Grid.Column="2" Text="{Binding SpeedMultiplier, StringFormat={}{0:0.00}x}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <TextBlock Text="Participants" FontWeight="Bold" Margin="0,16,0,4" />
                <TextBlock Text="Checked controllers share this one animation as a single canvas — a wave or chase visibly continues from one grid into the next, left to right in the order checked."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding ParticipantChoices}" AutomationProperties.Name="Animation participants">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No confirmed controller has an animatable LED grid right now."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ParticipantChoices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox Content="Loop" IsChecked="{Binding Loop}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Content="Play" Click="Play_OnClick" MinWidth="80" Margin="0,0,8,0" />
                <Button Content="Stop" Click="Stop_OnClick" MinWidth="80" Margin="0,0,16,0" />
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
