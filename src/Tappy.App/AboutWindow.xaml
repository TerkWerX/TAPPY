<Window x:Class="Tappy.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Tappy" Width="600" Height="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Tappy;component/Assets/Icons/tappy.ico"
        AutomationProperties.Name="About Tappy">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="16" Padding="24" Margin="16">
        <StackPanel>
            <Image Source="/Tappy;component/Assets/Branding/tappy-hand.png"
                   Height="330" Stretch="Uniform" SnapsToDevicePixels="True"
                   AutomationProperties.Name="Tappy tattooed hand mascot" />
            <TextBlock Text="Tappy" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock x:Name="VersionText" FontSize="14" HorizontalAlignment="Center" Margin="0,2,0,14" />
            <TextBlock TextWrapping="Wrap" LineHeight="22"
                       Text="A local Windows utility for turning a deliberately selected numpad, keyboard-style hand controller, or Logitech G13 into a programmable control surface." />
            <Border Background="{DynamicResource RaisedBrush}" CornerRadius="9" Padding="12" Margin="0,16,0,16">
                <TextBlock TextWrapping="Wrap" Text="Early development · Device-aware pass-through. Raw Input identifies the selected controller but does not block its original keystrokes system-wide." />
            </Border>
            <TextBlock Text="by TerkWerX.com" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Acknowledgment: architecture concepts were informed by the TerkWerX sister project for foot controls."
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,12" />
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="TerkWerX" Click="TerkWerX_OnClick" AutomationProperties.Name="Open TerkWerX website" />
                <Button Content="GitHub source" Click="GitHub_OnClick" AutomationProperties.Name="Open Tappy source repository on GitHub" />
                <Button Content="Project support" Click="Support_OnClick" AutomationProperties.Name="Open Tappy project support" />
                <Button Content="Optional PayPal support" Click="PayPal_OnClick" AutomationProperties.Name="Open optional PayPal support" />
                <Button Content="Close" Click="Close_OnClick" IsDefault="True" />
            </WrapPanel>
            <TextBlock x:Name="CopyrightText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Window>
