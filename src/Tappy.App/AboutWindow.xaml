<Window x:Class="Tappy.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Tappy" Width="500" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" AutomationProperties.Name="About Tappy">
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="28" Margin="16">
        <StackPanel>
            <TextBlock Text="Tappy" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" />
            <TextBlock x:Name="VersionText" FontSize="14" Margin="0,4,0,14" />
            <TextBlock TextWrapping="Wrap" LineHeight="22"
                       Text="A local Windows utility for turning a deliberately selected numpad, keyboard-style hand controller, or Logitech G13 into a programmable control surface." />
            <Border Background="{DynamicResource RaisedBrush}" CornerRadius="9" Padding="12" Margin="0,16,0,16">
                <TextBlock TextWrapping="Wrap" Text="Early development · Device-aware pass-through. Raw Input identifies the selected controller but does not block its original keystrokes system-wide." />
            </Border>
            <TextBlock Text="by TerkWerX.com" FontWeight="SemiBold" />
            <TextBlock Text="Acknowledgment: architecture concepts were informed by the TerkWerX sister project for foot controls." TextWrapping="Wrap" Margin="0,8,0,12" />
            <WrapPanel>
                <Button Content="TerkWerX" Click="TerkWerX_OnClick" AutomationProperties.Name="Open TerkWerX website" />
                <Button Content="GitHub source" Click="GitHub_OnClick" AutomationProperties.Name="Open Tappy source repository on GitHub" />
                <Button Content="Project support" Click="Support_OnClick" AutomationProperties.Name="Open Tappy project support" />
                <Button Content="Optional PayPal support" Click="PayPal_OnClick" AutomationProperties.Name="Open optional PayPal support" />
                <Button Content="Close" Click="Close_OnClick" IsDefault="True" />
            </WrapPanel>
            <TextBlock x:Name="CopyrightText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Window>
