<Window x:Class="Tappy.App.FireColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Fire pad color" Width="360" Height="360"
        MinWidth="360" MinHeight="360" WindowStartupLocation="CenterOwner"
        Icon="/Tappy;component/Assets/Icons/tappy.ico"
        ResizeMode="NoResize"
        AutomationProperties.Name="Custom Akai Fire pad color picker">
    <Grid Background="{DynamicResource WindowBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="72" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Margin="0,0,0,14">
            <Border.Background>
                <SolidColorBrush x:Name="PreviewBrush" Color="#FF6A00" />
            </Border.Background>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hex" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="HexTextBox" Grid.Column="1" MaxLength="7"
                     TextChanged="HexTextBox_OnTextChanged"
                     AutomationProperties.Name="Hex color code" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="R" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
                    TickFrequency="1" ValueChanged="ColorSlider_OnValueChanged" AutomationProperties.Name="Red" />
            <TextBlock Grid.Column="2" Text="{Binding ElementName=RedSlider, Path=Value, StringFormat={}{0:0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="G" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
                    TickFrequency="1" ValueChanged="ColorSlider_OnValueChanged" AutomationProperties.Name="Green" />
            <TextBlock Grid.Column="2" Text="{Binding ElementName=GreenSlider, Path=Value, StringFormat={}{0:0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="B" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
                    TickFrequency="1" ValueChanged="ColorSlider_OnValueChanged" AutomationProperties.Name="Blue" />
            <TextBlock Grid.Column="2" Text="{Binding ElementName=BlueSlider, Path=Value, StringFormat={}{0:0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_OnClick" Margin="0,0,10,0" MinWidth="80" />
            <Button Content="Use this color" Click="Ok_OnClick" MinWidth="120" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
