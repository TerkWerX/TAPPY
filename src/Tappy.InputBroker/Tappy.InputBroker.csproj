<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Tappy.InputBroker</RootNamespace>
    <AssemblyName>Tappy.InputBroker</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.IO.Pipes.AccessControl" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tappy.Core\Tappy.Core.csproj" />
    <ProjectReference Include="..\Tappy.Windows\Tappy.Windows.csproj" />
  </ItemGroup>
</Project>
