[Version]
Signature="$WINDOWS NT$"
Class=Keyboard
ClassGuid={4D36E96B-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=09/04/2026,0.1.0.0
CatalogFile=TappyKeyboardFilter.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[Manufacturer]
%ManufacturerName%=Models,NTamd64.10.0...22621

[Models.NTamd64.10.0...22621]
%DevelopmentDeviceDescription%=TappyFilter_Install,TAPPY\KeyboardFilterDevelopmentOnly

[TappyFilter_Install.NT]
CopyFiles=DriverCopyFiles

[TappyFilter_Install.NT.HW]
AddReg=FilterRegistration

[FilterRegistration]
HKR,,UpperFilters,0x00010000,"TappyKeyboardFilter"

[TappyFilter_Install.NT.Services]
AddService=TappyKeyboardFilter,0x00000002,TappyFilter_Service

[TappyFilter_Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\TappyKeyboardFilter.sys

[TappyFilter_Install.NT.Wdf]
KmdfService=TappyKeyboardFilter,TappyFilter_Wdf

[TappyFilter_Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[DriverCopyFiles]
TappyKeyboardFilter.sys

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
TappyKeyboardFilter.sys=1

[Strings]
ProviderName="TerkWerX"
ManufacturerName="TerkWerX"
DevelopmentDeviceDescription="Tappy keyboard filter (development placeholder; matches no retail device)"
ServiceDescription="Tappy optional per-device keyboard filter"
DiskName="Tappy keyboard filter installation media"
